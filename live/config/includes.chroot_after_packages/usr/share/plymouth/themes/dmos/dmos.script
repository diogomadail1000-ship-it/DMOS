# DMOS boot splash: the logo breathes above a thin tide bar.
Window.SetBackgroundTopColor(0.024, 0.039, 0.094);
Window.SetBackgroundBottomColor(0.024, 0.039, 0.094);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

background.image = Image("background.png");
background.scale = Math.Max(screen_w / background.image.GetWidth(), screen_h / background.image.GetHeight());
background.scaled = background.image.Scale(background.image.GetWidth() * background.scale, background.image.GetHeight() * background.scale);
background.sprite = Sprite(background.scaled);
background.sprite.SetX(Window.GetX() + (screen_w - background.scaled.GetWidth()) / 2);
background.sprite.SetY(Window.GetY() + (screen_h - background.scaled.GetHeight()) / 2);
background.sprite.SetZ(-100);

logo.image = Image("logo.png");
logo.size = Math.Min(screen_h * 0.14, 150);
logo.scaled = logo.image.Scale(logo.size, logo.size);
logo.sprite = Sprite(logo.scaled);
logo.x = Window.GetX() + (screen_w - logo.size) / 2;
logo.y = Window.GetY() + (screen_h - logo.size) / 2 - logo.size * 0.2;
logo.sprite.SetPosition(logo.x, logo.y, 10);

bar.width = Math.Min(screen_w * 0.18, 300);
bar.height = 3;
bar.x = Window.GetX() + (screen_w - bar.width) / 2;
bar.y = logo.y + logo.size + screen_h * 0.05;
bar.track = Image("track.png").Scale(bar.width, bar.height);
bar.track_sprite = Sprite(bar.track);
bar.track_sprite.SetPosition(bar.x, bar.y, 11);
bar.fill = Image("tide.png");
bar.fill_sprite = Sprite();
bar.fill_sprite.SetPosition(bar.x, bar.y, 12);

fun set_progress(fraction) {
    width = Math.Int(bar.width * fraction);
    if (width < 1) width = 1;
    bar.fill_sprite.SetImage(bar.fill.Scale(width, bar.height));
}

time = 0;
progress_value = 0;

fun refresh_callback() {
    time++;
    # Slow breathing: about one breath every four seconds at 50 Hz.
    logo.sprite.SetOpacity(0.72 + 0.28 * Math.Sin(time * 0.0314));
    if (Plymouth.GetMode() == "boot") {
        # Boot progress often stalls: creep forward so the bar never looks frozen.
        target = Math.Clamp(progress_value, 0, 1);
        shown = shown + (target - shown) * 0.04 + 0.0002;
        if (shown > 1) shown = 1;
        set_progress(shown);
    } else {
        set_progress(1);
    }
}
shown = 0;
Plymouth.SetRefreshFunction(refresh_callback);

fun boot_progress_callback(duration, progress) {
    progress_value = progress;
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

# Password prompt for encrypted disks.
prompt_sprite = Sprite();
bullets_sprite = Sprite();

fun display_normal_callback() {
    prompt_sprite.SetOpacity(0);
    bullets_sprite.SetOpacity(0);
}

fun display_password_callback(prompt, bullets) {
    text = Image.Text(prompt, 0.91, 0.93, 0.96, 1, "Inter 13");
    prompt_sprite.SetImage(text);
    prompt_sprite.SetPosition(Window.GetX() + (screen_w - text.GetWidth()) / 2, bar.y + 26, 20);
    prompt_sprite.SetOpacity(1);
    dots = "";
    for (i = 0; i < bullets; i++) dots += "• ";
    if (dots == "") dots = " ";
    image = Image.Text(dots, 0.18, 0.83, 0.75, 1, "Inter 15");
    bullets_sprite.SetImage(image);
    bullets_sprite.SetPosition(Window.GetX() + (screen_w - image.GetWidth()) / 2, bar.y + 56, 20);
    bullets_sprite.SetOpacity(1);
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
