#!/bin/sh
# Opens "Bem-vindo ao DMOS". With --first-run it opens only until the user finishes it once.
# --page <inicio|aparencia|ligacao|noticias|pronto> opens a given page.
if [ "$1" = "--first-run" ]; then
    [ "$(kreadconfig6 --file dmosrc --group Welcome --key Done)" = "true" ] && exit 0
    shift
fi
exec /usr/lib/qt6/bin/qml /usr/share/dmos/welcome/Main.qml -- "$@"
